# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# security & credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.jks
*.keystore
id_rsa*
id_ecdsa*
id_ed25519*
secrets.*
credentials.*

# database local files & backups (excluding prisma migrations)
*.dump
*.sql.gz
*.sql.tar
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite-journal

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (strictly excluded except template)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env*
!.env.example
*.env
*.env.*

# editor & ide
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.backup
/scratch/
/tmp/
/temp/

# playwright
/playwright-report
/test-results

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
