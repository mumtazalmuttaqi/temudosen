# Database PostgreSQL (wajib)
DATABASE_URL="postgresql://postgres:postgres_dev_password@localhost:5432/temudosen?schema=public"

# Session & JWT Signing Secret (minimal 32 karakter acak di production)
SESSION_SECRET="change-this-to-a-strong-random-32-char-secret-in-production"

# URL aplikasi untuk validasi CSRF / Origin dan metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environment
NODE_ENV="development"

# Asumsi konfigurasi awal kampus (dapat diubah admin melalui tabel system_settings)
DEFAULT_CAMPUS_TIMEZONE="Asia/Jakarta"
DEFAULT_PENDING_HOLD_HOURS="24"
DEFAULT_CANCELLATION_CUTOFF_HOURS="12"

